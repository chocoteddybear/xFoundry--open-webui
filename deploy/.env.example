# Lives only on the server (/opt/owui-demo/.env), never in git. setup-droplet.sh creates it.
# Values with $ must stay in single quotes.
SITE_ADDRESS=<ip-with-dashes>.sslip.io
# Secret for the access link https://SITE_ADDRESS/?key=DEMO_KEY (openssl rand -hex 32).
DEMO_KEY=replace-with-64-random-hex-characters
WEBUI_SECRET_KEY='replace-with-a-long-random-string'
IMAGE_TAG=latest
